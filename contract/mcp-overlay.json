{
  "schema_version": 1,
  "openapi_url": "https://tokenlab.sh/docs/openapi.json",
  "default_profile": "core",
  "profiles": {
    "catalog": {
      "schema_mode": "exact",
      "compatibility_budget": {
        "max_endpoint_tools": 4,
        "max_input_schema_bytes": 2000,
        "max_input_schema_depth": 4,
        "max_tools_list_bytes": 6000
      },
      "operations": [
        "listModels",
        "getModel",
        "getModelPricing",
        "getPricing"
      ]
    },
    "core": {
      "schema_mode": "portable",
      "compatibility_budget": {
        "max_endpoint_tools": 30,
        "max_input_schema_bytes": 48000,
        "max_input_schema_depth": 8,
        "max_tools_list_bytes": 60000
      },
      "operations": [
        "listModels",
        "getModel",
        "getModelPricing",
        "getPricing",
        "createChatCompletion",
        "createResponse",
        "createAnthropicMessage",
        "geminiGenerateContent",
        "createSystemOneDecision",
        "createEmbedding",
        "createMultimodalEmbedding",
        "rerankDocuments",
        "createTranslation",
        "createImage",
        "editImage",
        "createVideo",
        "createMusic",
        "create3D",
        "getAsyncTask",
        "cancelAsyncTask",
        "createSpeech",
        "createTranscription",
        "createAudioTranslation",
        "uploadFile",
        "listFiles",
        "retrieveFile",
        "retrieveFileContent",
        "deleteFile"
      ]
    },
    "full": {
      "schema_mode": "portable",
      "compatibility_budget": {
        "max_endpoint_tools": 87,
        "max_input_schema_bytes": 78000,
        "max_input_schema_depth": 8,
        "max_tools_list_bytes": 115000,
        "max_gemini_declarations_bytes": 90000
      },
      "include_tags": [
        "Chat",
        "Embeddings",
        "Images",
        "Audio",
        "Video",
        "Tasks",
        "Models",
        "Responses",
        "Anthropic",
        "Gemini",
        "Files",
        "Batches",
        "Text",
        "Decisions",
        "Worlds",
        "Seedance Volc Compatible",
        "Webhooks"
      ],
      "exclude_operations": [
        "geminiStreamGenerateContent",
        "connectRealtime"
      ]
    }
  },
  "operation_variants": {
    "dispatchVolcCompatibleSeedanceActionPost": [
      {
        "tool_name": "create_visual_validate_session",
        "title": "Create visual validation session",
        "description": "Create a real-person visual validation session through the Volc-compatible Action API. Returns the official ResponseMetadata and Result shape with BytedToken, H5Link, and CallbackURL.",
        "request_schema": "#/components/schemas/VolcCreateVisualValidateSessionRequest",
        "fixed_arguments": {
          "Action": "CreateVisualValidateSession",
          "Version": "2024-01-01"
        }
      },
      {
        "tool_name": "get_visual_validate_result",
        "title": "Get visual validation result",
        "description": "Get the mapped real-person material GroupId through the Volc-compatible Action API after the H5 validation succeeds. The operation returns the official ResponseMetadata and Result shape.",
        "request_schema": "#/components/schemas/VolcGetVisualValidateResultRequest",
        "fixed_arguments": {
          "Action": "GetVisualValidateResult",
          "Version": "2024-01-01"
        },
        "annotations": {
          "idempotentHint": true
        }
      }
    ]
  },
  "public_contract": {
    "landing_url": "https://tokenlab.sh/mcp",
    "docs_url": "https://tokenlab.sh/docs/en/integrations/tokenlab-mcp-server",
    "recommended_client_name": "tokenlab",
    "live_model_contract": {
      "tool": "get_model",
      "endpoint": "/v1/models/{model}",
      "fields": [
        "supported_operations",
        "supported_parameters",
        "request_endpoint",
        "request_endpoint_by_operation",
        "request_shape_mode",
        "operation_constraints",
        "recommended_request"
      ]
    },
    "composite_tools": [
      {
        "name": "compare_models",
        "profiles": [
          "catalog",
          "core",
          "full"
        ],
        "auth": "optional",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true
        }
      },
      {
        "name": "get_api_overview",
        "profiles": [
          "catalog",
          "core",
          "full"
        ],
        "auth": "optional",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true
        }
      }
    ],
    "core_tool_layers": [
      {
        "id": "discover",
        "authentication": "none",
        "tool_rows": [
          [
            "list_models",
            "get_model",
            "get_pricing"
          ],
          [
            "get_model_pricing",
            "compare_models",
            "get_api_overview"
          ]
        ]
      },
      {
        "id": "create",
        "authentication": "api_key",
        "tool_rows": [
          [
            "create_chat_completion",
            "create_response",
            "create_anthropic_message",
            "create_gemini_content",
            "evaluate_decisions"
          ],
          [
            "create_image",
            "create_image_file",
            "edit_image",
            "edit_image_file"
          ],
          [
            "create_video",
            "create_music",
            "create_3d_model",
            "create_speech",
            "transcribe_audio",
            "translate_audio"
          ]
        ]
      },
      {
        "id": "operate",
        "authentication": "api_key",
        "tool_rows": [
          [
            "upload_file",
            "list_files",
            "retrieve_file"
          ],
          [
            "retrieve_file_content",
            "delete_file",
            "get_task_status",
            "cancel_task"
          ],
          [
            "create_embedding",
            "create_multimodal_embedding",
            "rerank_documents",
            "translate_text"
          ]
        ]
      }
    ],
    "resources": [
      {
        "name": "tokenlab-api-overview",
        "title": "TokenLab API Overview",
        "uri": "tokenlab://api/overview",
        "mime_type": "text/plain",
        "freshness": "live"
      },
      {
        "name": "tokenlab-openapi-contract",
        "title": "TokenLab OpenAPI Contract",
        "uri": "tokenlab://contract/openapi",
        "mime_type": "application/json",
        "freshness": "package_snapshot"
      },
      {
        "name": "tokenlab-mcp-public-contract",
        "title": "TokenLab MCP Public Contract",
        "uri": "tokenlab://contract/mcp",
        "mime_type": "application/json",
        "freshness": "package_snapshot"
      }
    ],
    "prompts": [
      {
        "name": "choose_tokenlab_model",
        "title": "Choose a TokenLab Model"
      },
      {
        "name": "build_tokenlab_request",
        "title": "Build a TokenLab Request"
      }
    ]
  },
  "public_auth_operations": [
    "listModels",
    "getModel",
    "getModelPricing",
    "getPricing"
  ],
  "operation_overrides": {
    "listModels": {
      "default_arguments": {
        "view": "compact"
      },
      "input_property_overrides": {
        "view": {
          "description": "compact by default; full returns the complete OpenAI-compatible list."
        },
        "provider": {
          "description": "Public provider filter (openai/anthropic/google/minimax)."
        },
        "recommended_for": {
          "description": "Sort non-chat models for a task; include recommendation evidence."
        }
      }
    },
    "cancelAnthropicMessageBatch": {
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    "cancelBatch": {
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    "compactResponse": {
      "fixed_arguments": {
        "stream": false
      }
    },
    "createAnthropicMessage": {
      "tool_name": "create_anthropic_message",
      "fixed_arguments": {
        "stream": false
      },
      "input_property_overrides": {
        "model": {
          "description": "Model ID."
        }
      }
    },
    "geminiGenerateContent": {
      "tool_name": "create_gemini_content",
      "omit_arguments": [
        "key",
        "system_instruction",
        "generation_config",
        "safety_settings",
        "tool_config",
        "cached_content"
      ],
      "input_property_overrides": {
        "model": {
          "description": "Gemini model ID."
        },
        "tools": {
          "description": "Gemini tools; allowed types/combinations depend on the selected service."
        }
      }
    },
    "createChatCompletion": {
      "description": "Create an OpenAI-compatible chat completion. For inline image_url data URLs, declare the byte-accurate image MIME type. The MCP boundary corrects recognized PNG, JPEG, WebP, and GIF payloads declared as application/octet-stream and rejects unrecognized generic binary image payloads before sending a billable request.",
      "fixed_arguments": {
        "stream": false
      },
      "input_property_overrides": {
        "model": {
          "description": "Model ID."
        },
        "user": {
          "description": "User ID for abuse detection."
        },
        "functions": {
          "description": "Legacy function definitions."
        },
        "function_call": {
          "description": "Legacy function selection."
        },
        "top_logprobs": {
          "description": "Top token count per position; requires logprobs."
        },
        "translation_options": {
          "description": "Audio/video translation language settings."
        },
        "prediction": {
          "description": "Draft/speculative decoding hints."
        },
        "service_tier": {
          "description": "Standard tier pricing; auto/default forwarded; flex/priority/fast/ultrafast ignored."
        },
        "extra": {
          "description": "extra.prompt_caching/extra.prompt_caching_ttl alias anthropic_options."
        }
      }
    },
    "createResponse": {
      "fixed_arguments": {
        "stream": false
      },
      "input_property_overrides": {
        "input": {
          "description": "String or structured input items."
        },
        "prompt": {
          "description": "Reusable prompt template and variables."
        },
        "service_tier": {
          "description": "Standard tier pricing; auto/default forwarded; flex/priority/fast/ultrafast ignored."
        },
        "tools": {
          "description": "Tools; allowed types/combinations depend on the selected service."
        }
      }
    },
    "retrieveResponse": {
      "fixed_arguments": {
        "stream": false
      }
    },
    "getAsyncTask": {
      "tool_name": "get_task_status",
      "task": {
        "mode": "status",
        "id_fields": [
          "task_id",
          "id"
        ],
        "status_field": "status",
        "poll_url_field": "poll_url",
        "terminal_statuses": [
          "completed",
          "succeeded",
          "failed",
          "cancelled",
          "canceled",
          "expired"
        ]
      },
      "input_property_overrides": {
        "id": {
          "description": "Returned id/task_id or the ID in poll_url."
        }
      }
    },
    "cancelAsyncTask": {
      "tool_name": "cancel_task",
      "task": {
        "mode": "status",
        "id_fields": [
          "task_id",
          "id"
        ],
        "status_field": "status",
        "poll_url_field": "poll_url",
        "terminal_statuses": [
          "completed",
          "succeeded",
          "failed",
          "cancelled",
          "canceled",
          "expired"
        ]
      },
      "input_property_overrides": {
        "id": {
          "description": "Returned id/task_id or the ID in poll_url."
        }
      }
    },
    "createSystemOneDecision": {
      "tool_name": "evaluate_decisions",
      "description": "Evaluate typed Noul probability, Choice, and Score questions against shared state using the native System One endpoint. Discover a decision model with list_models/get_model first. Returns synchronous structured decisions, not chat text. A decision does not authorize an external action."
    },
    "createTranslation": {
      "tool_name": "translate_text"
    },
    "createAudioTranslation": {
      "tool_name": "translate_audio"
    },
    "createTranscription": {
      "tool_name": "transcribe_audio",
      "input_property_overrides": {
        "model": {
          "description": "Transcription model ID; no default."
        }
      }
    },
    "createImage": {
